# DDL adapter for Codex: command rules (loaded only for a trusted project).
# A push leaves the machine, so it is confirmed at the moment it runs, on top of the approval
# given in the $commit report. Sessions whose approval policy never prompts show nothing;
# the report's approval still applies (the protocol's Approval operation).
# Independently, the hook requires a matching content-bound native Git review (the protocol's Git review
# operation), even under never.
# Exact prefixes cannot skip Git global options. The independent PreToolUse form guard
# rejects recognized noncanonical pushes; it never asks, rewrites, or grants permission.
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "DDL: a push needs the user's approval at the moment it runs",
    match = ["git push", "git push origin main", "git push --tags"],
    not_match = ["git status", "git -C /tmp push", "git -c push.default=current push"],
)
