{
  "description": "DDL adapter for Codex (AGENTS.md, Codex Runtime Contract). The gate hook enforces the mechanical half of +++STOP: after a +++DDL_REPORT and until the next user prompt, apply_patch, writing shell commands, spawn_agent, and MCP tool calls are denied. SessionStart injects design.md so it stays in context. Codex loads this file only for a trusted project and runs these hooks only after you trust them in /hooks. The rules themselves live in the skills and AGENTS.md and stay the same without this file; the adapter only enforces their mechanical part.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Bash|shell|exec_command|local_shell|shell_command|spawn_agent|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/ddl_gate.py\" pre-tool-use --runtime codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/ddl_gate.py\" stop --runtime codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/ddl_gate.py\" user-prompt-submit --runtime codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|fork|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.codex/hooks/ddl_gate.py\" session-start --runtime codex",
            "timeout": 10,
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
